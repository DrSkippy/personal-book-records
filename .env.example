# .env.example — copy to .env and fill in
# These are the env vars docker-compose.yml passes through to the containers.
# Database credentials and ISBN key live in tools/book_service/config/configuration.json instead.

# Must match api_key in configuration.json. Generate with: openssl rand -hex 20
API_KEY=

# Optional: override configuration.json's ai_agent.embed_* fields (RAG semantic
# search embeddings, used by both book-service and booksmcp). Leave blank to
# use the values baked into configuration.json.
AI_EMBED_HOST=
AI_EMBED_MODEL=
AI_EMBED_API_KEY=
AI_EMBED_DIMENSIONS=

# Optional: override configuration.json's ai_agent.chat_* fields (the AI Chat
# page's POST /chat endpoint, served by book-service; not used by booksmcp).
# Leave blank to use the values baked into configuration.json.
AI_CHAT_HOST=
AI_CHAT_MODEL=
AI_CHAT_API_KEY=
