# .env.local.example — copy to .env.local and fill in
# Vite bakes these into the JS bundle at build time (npm run build).
# After editing, re-run: npm run build

# REST API base URL, no trailing slash
# With unified nginx config: https://books.drskippy.app/api
# For local-only access: http://localhost:83/api
VITE_API_BASE_URL=

# API key — must match api_key in tools/book_service/config/configuration.json
VITE_API_KEY=

# Base URL for static book cover images, no trailing slash
VITE_RESOURCE_BASE_URL=

# AI Chat: no frontend configuration needed. The chat page calls POST /chat
# on the REST API (via VITE_API_BASE_URL/VITE_API_KEY above); the backend
# owns the chat model, host, and API key via ai_agent.chat_* in
# tools/book_service/config/configuration.json.
